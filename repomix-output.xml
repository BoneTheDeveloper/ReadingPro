function OptionButton({
  optionId,
  optionText,
  isSelected,
  isCorrectOption,
  showFeedback,
  onSelect,
}: {
  optionId: string;
  optionText: string;
  isSelected: boolean;
  isCorrectOption: boolean;
  showFeedback: boolean;
  onSelect: (id: string) => void;
}) {
  return (
    <button
      onClick={() => onSelect(optionId)}
