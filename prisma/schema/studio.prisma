// [Study · Studio] Studio-generated artifacts and their content. StudioArtifact
// is the generic card produced by a studio action; type-specific content (e.g.
// Question) hangs off it relationally so the card stays generic across artifact
// types. QuizResult also feeds the progress module.

/// A studio output card (a quiz or flashcard set) generated from a passage.
/// Stays generic across types; type-specific rows attach via relations.
/// Client: studio panel cards; status drives the generating/ready/error state.
model StudioArtifact {
  /// UUID supplied by the client at creation (optimistic card) — NOT db-generated.
  id        String   @id @db.Uuid
  passageId String   @db.Uuid
  userId    String
  /// Artifact kind: 'quiz' | 'flashcard'.
  type      String
  title     String
  /// Generation state: 'generating' | 'done' | 'failed'.
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passage    Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions  Question[]
  quizResult QuizResult?

  @@index([passageId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("studio_artifacts")
}

/// A single quiz question belonging to a quiz artifact. Client: studio quiz
/// content (question text, options, grading, explanation).
model Question {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passageId     String       @db.Uuid
  artifactId    String       @db.Uuid
  questionText  String
  /// Answer options as UI objects; their ids are plain UI keys, NOT entity ids.
  options       Json
  /// Id of the correct option — matches an `options[].id` (a UI key, not a FK).
  correctOption String
  /// Passage excerpt the question is drawn from.
  sourceText    String
  /// Line number of `sourceText` within the passage.
  sourceLine    Int
  explanation   String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  /// Difficulty 1-5.
  difficulty    Int          @default(3)
  createdAt     DateTime     @default(now())

  passage  Passage        @relation(fields: [passageId], references: [id], onDelete: Cascade)
  artifact StudioArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([passageId])
  @@index([artifactId])
  @@map("questions")
}

/// Graded outcome of a quiz run, 1:1 with the quiz StudioArtifact. Client: studio
/// quiz results screen; also aggregated into the progress dashboard.
model QuizResult {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The quiz artifact graded; unique — at most one result per quiz.
  artifactId     String   @unique @db.Uuid
  completedAt    DateTime @default(now())
  correctCount   Int
  totalQuestions Int
  /// Computed accuracy = correctCount / totalQuestions.
  accuracyRate   Float

  artifact StudioArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}
