generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

//[better-auth-model]

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt   DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id         String   @id
  expiresAt  DateTime
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model User {
  id               String         @id
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tier             String?        @default("FREE")
  accounts         Account[]
  userProfile      UserProfile?
  sessions         Session[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


//[app-model]

model UserProfile {
  id                   String                  @id
  bio                  String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  timezone             String                  @default("Asia/Bangkok")
  desiredRetention     Float                   @default(0.9)
  // Optimized FSRS weights; null means the library defaults.
  fsrsParams           Json?
  passages             Passage[]
  user                 User                    @relation(fields: [id], references: [id], onDelete: Cascade)
  vocabularyItems      VocabularyItem[]
  vocabularySets       VocabularySet[]
  reviewSessions       ReviewSession[]
}

model Passage {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String
  title                 String                  @default("")
  content               String                  @default("")
  cefrLevel             CEFRLevel?
  wordCount             Int                     @default(0)
  sourceType            SourceType
  filePath              String?                 @unique
  createdAt             DateTime                @default(now())
  youtubeUrl            String?
  status                ProcessingStatus        @default(PENDING)
  userProfile           UserProfile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioArtifacts       StudioArtifact[]
  ChatMessages     ChatMessage[]
  vocabularyItems       VocabularyItem[]

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}
//studio-model
model StudioArtifact {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passageId String             @db.Uuid
  userId    String
  type      StudioArtifactType
  createdAt DateTime          @default(now())
  content   Json?
  progress  Json?
  status    ProcessingStatus  @default(PENDING)
  passage   Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([passageId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model ChatMessage {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  passageId   String      @db.Uuid
  role        String
  content     String
  createdAt   DateTime    @default(now())
  passage     Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId, createdAt])
}

//vocabulary
model VocabularyItem {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String

  // Both normalized: trimmed, whitespace collapsed, lowercased.
  term               String
  targetLanguage     String
  translation        String
  sourceLanguage     String
  partofSpeech       PartOfSpeech

  savedCount         Int                 @default(1)

  // A word lives in exactly one set; words the user has not filed sit in the default set.
  vocabularySetId    String              @db.Uuid

  // Where the word was first saved; shown on the back of the review card.
  contextSentence    String?
  passageId          String?             @db.Uuid

  // Written only by the review scheduler. Names mirror the ts-fsrs Card type.
  status             VocabularyStatus    @default(NEW)
  dueAt              DateTime            @default(now())
  stability          Float               @default(0)
  difficulty         Float               @default(0)
  scheduledDays      Int                 @default(0)
  learningSteps      Int                 @default(0)
  reps               Int                 @default(0)
  lapses             Int                 @default(0)
  lastReviewAt       DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  userProfile        UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage            Passage?            @relation(fields: [passageId], references: [id], onDelete: SetNull)
  // NoAction, not Restrict: deleting a profile removes its sets and words in one
  // statement, which Restrict would reject. A set is emptied before it is deleted.
  vocabularySet      VocabularySet       @relation(fields: [vocabularySetId], references: [id], onDelete: NoAction)
  reviewLogs         ReviewLog[]

  @@unique([userId, term, translation])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([vocabularySetId])
}

model VocabularySet {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String
  name               String
  // The set new words land in. One per user; it cannot be deleted.
  isDefault          Boolean             @default(false)
  // New words of this set that may be introduced per user-local day.
  dailyNewLimit      Int                 @default(10)
  createdAt          DateTime            @default(now())

  vocabularyItems    VocabularyItem[]
  reviewSessions     ReviewSession[]
  userProfile        UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model ReviewSession {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String
  // Null means the session covers the due cards of every set.
  vocabularySetId String?        @db.Uuid
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  cardsReviewed   Int            @default(0)

  userProfile     UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularySet   VocabularySet? @relation(fields: [vocabularySetId], references: [id], onDelete: SetNull)
  reviewLogs      ReviewLog[]

  @@index([userId, startedAt(sort: Desc)])
}

// One row per rating. status, dueAt, stability, difficulty and learningSteps hold
// the card state before the rating; scheduledDays is the interval after it.
model ReviewLog {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String
  vocabularyItemId String           @db.Uuid
  sessionId        String?          @db.Uuid
  // Sent by the client so a resent rating is not counted twice.
  clientReviewId   String           @unique @db.Uuid
  rating           ReviewRating
  status           VocabularyStatus
  dueAt            DateTime
  stability        Float
  difficulty       Float
  elapsedDays      Int
  scheduledDays    Int
  learningSteps    Int
  durationMs       Int?
  reviewedAt       DateTime         @default(now())

  vocabularyItem   VocabularyItem   @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  session          ReviewSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([vocabularyItemId, reviewedAt])
  @@index([userId, reviewedAt])
}

//[enum]
enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SourceType {
  TEXT
  PDF
  YOUTUBE
}

enum VocabularyStatus {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum StudioArtifactType {
  QUESTION
  FLASHCARD
}

enum ProcessingStatus {
  PENDING    @map("pending")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  PHRASE
  OTHER
}
