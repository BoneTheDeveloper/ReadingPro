generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER PROFILE MODEL
// ============================================
model UserProfile {
  id               String    @id
  email            String?
  name             String?
  avatarUrl        String?
  bio              String?
  targetLevel      CEFRLevel @default(B2)
  tier             Tier      @default(FREE)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  passages             Passage[]
  studySessions        StudySession[]
  cardReviews          CardReview[]
  chatMessages         StudyChatMessage[]
  translationCaches    TranslationCache[]
  translationHistories TranslationHistory[]
  vocabularyItems      VocabularyItem[]
  vocabularySets       VocabularySet[]
  fileUploadIntents    FileUploadIntent[]
  quizAttempts         QuizAttempt[]

  @@map("profiles")
}

// ============================================
// PASSAGE MODEL
// ============================================
model Passage {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  title             String
  content           String
  simplifiedContent String?
  originalLevel     CEFRLevel?
  simplifiedLevel   CEFRLevel?
  wordCount         Int
  sourceType        SourceType
  filePath          String?    @unique
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user                 UserProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions            Question[]
  chatMessages         StudyChatMessage[]
  translationCaches    TranslationCache[]
  translationHistories TranslationHistory[]
  quizAttempts         QuizAttempt[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deletedAt])
  @@map("passages")
}

model StudyChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  passageId String   @db.Uuid
  role      String
  content   String
  createdAt DateTime @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId, createdAt])
  @@map("study_chat_messages")
}

model DictionaryEntry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  headword           String
  normalizedHeadword String
  sourceLanguage     String   @default("en")
  frequencyRank      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  senses  DictionarySense[]
  aliases DictionaryAlias[]

  @@unique([normalizedHeadword, sourceLanguage])
  @@index([sourceLanguage, frequencyRank])
  @@map("dictionary_entries")
}

model DictionarySense {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId      String   @db.Uuid
  partOfSpeech String?
  definition   String?
  example      String?
  tags         String[]
  usageRank    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entry        DictionaryEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  translations DictionaryTranslation[]

  @@index([entryId, usageRank])
  @@map("dictionary_senses")
}

model DictionaryTranslation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senseId        String    @db.Uuid
  targetLanguage String    @default("vi")
  translation    String
  isPrimary      Boolean   @default(false)
  rank           Int
  confidence     Float?
  status         String    @default("draft")
  sourceType     String
  sourceName     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sense DictionarySense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId, targetLanguage, status, isPrimary])
  @@index([targetLanguage, status, rank])
  @@map("dictionary_translations")
}

model DictionaryAlias {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId         String @db.Uuid
  normalizedAlias String
  aliasType       String @default("variant")

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([normalizedAlias, entryId])
  @@index([normalizedAlias])
  @@map("dictionary_aliases")
}

model DictionarySourceAudit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchName  String
  entityType String
  entityId   String   @db.Uuid
  note       String?
  createdAt  DateTime @default(now())

  @@index([batchName])
  @@index([entityType, entityId])
  @@map("dictionary_source_audits")
}

model TranslationCache {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cacheKey        String   @unique
  userId          String
  sourceId        String   @db.Uuid
  selectedText    String
  contextSentence String
  sourceLanguage  String
  targetLanguage  String
  mode            String
  provider        String
  response        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, targetLanguage])
  @@index([userId, createdAt])
  @@map("translation_caches")
}

model TranslationHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String
  sourceId        String   @db.Uuid
  selectedText    String
  contextSentence String
  sourceLanguage  String
  targetLanguage  String
  mode            String
  provider        String
  translation     String
  response        Json
  createdAt       DateTime @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, createdAt])
  @@map("translation_histories")
}

// ============================================
// VOCABULARY MODELS
// ============================================
model VocabularyItem {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String
  translation        String
  sourceLanguage     String
  targetLanguage     String
  type               String              @default("WORD")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  normalizedText     String              @default("")
  displayText        String              @default("")
  status             String              @default("NEW")
  source             String              @default("TRANSLATE")
  savedCount         Int                 @default(1)
  nextReviewAt       DateTime?
  lastReviewedAt     DateTime?
  dictionaryEntryId  String?             @db.Uuid
  dictionarySenseId  String?             @db.Uuid

  user            UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences     VocabularyOccurrence[]
  setItems        VocabularySetItem[]

  @@unique([userId, normalizedText, targetLanguage, translation])
  @@index([userId, nextReviewAt])
  @@index([userId, status])
  @@map("vocabulary_items")
}

model VocabularyOccurrence {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vocabularyItemId String         @db.Uuid
  sourceId         String?        @db.Uuid
  selectedText     String
  contextSentence  String?
  createdAt        DateTime       @default(now())

  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([vocabularyItemId, sourceId, contextSentence])
  @@index([sourceId])
  @@map("vocabulary_occurrences")
}

model VocabularySet {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  name        String
  type        VocabularySetType
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  setItems  VocabularySetItem[]

  @@unique([userId, type, periodStart, periodEnd])
  @@index([userId, type])
  @@map("vocabulary_sets")
}

model VocabularySetItem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vocabularySetId  String        @db.Uuid
  vocabularyItemId String        @db.Uuid
  addedAt          DateTime      @default(now())

  vocabularySet  VocabularySet  @relation(fields: [vocabularySetId], references: [id], onDelete: Cascade)
  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([vocabularySetId, vocabularyItemId])
  @@map("vocabulary_set_items")
}

// ============================================
// QUESTION MODEL (Flashcards)
// ============================================
model Question {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passageId     String       @db.Uuid
  questionText  String
  options       Json
  correctOption String
  sourceText    String
  sourceLine    Int
  explanation   String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  difficulty    Int          @default(3)
  createdAt     DateTime     @default(now())

  passage Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  reviews CardReview[]

  @@index([passageId])
  @@map("questions")
}

// ============================================
// CARD REVIEW MODEL (SM-2 Tracking)
// ============================================
model CardReview {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String @db.Uuid
  userId     String

  qualityRating Int
  easeFactor    Float @default(2.5)
  intervalDays  Int   @default(1)
  repetitions   Int   @default(0)

  nextReviewDate DateTime @default(now())
  reviewedAt     DateTime @default(now())

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId, nextReviewDate])
  @@map("card_reviews")
}

// ============================================
// STUDY SESSION MODEL
// ============================================
model StudySession {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user         UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ============================================
// QUIZ ATTEMPT MODEL
// ============================================
model QuizAttempt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studySessionId  String    @db.Uuid
  userId          String
  passageId       String?   @db.Uuid

  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)
  totalQuestions  Int       @default(0)
  accuracyRate    Float?

  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  studySession StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage      Passage?     @relation(fields: [passageId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("quiz_attempts")
}

// ============================================
// PRIVATE BLOB UPLOAD INTENT MODEL
// ============================================
model FileUploadIntent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  pathname  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("file_upload_intents")
}

// ============================================
// ENUMS
// ============================================
enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SourceType {
  TEXT
  PDF
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Tier {
  FREE
  PRO
}

enum VocabularySetType {
  MANUAL
  DAILY
  WEEKLY
}
