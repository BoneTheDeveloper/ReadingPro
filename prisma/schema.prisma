generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER PROFILE MODEL
// ============================================
model UserProfile {
  id               String    @id
  email            String?   @unique
  name             String?
  avatarUrl        String?
  bio              String?
  targetLevel      CEFRLevel @default(B2)
  tier             Tier      @default(FREE)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  passages      Passage[]
  studySessions StudySession[]
  cardReviews   CardReview[]
  chatMessages  StudyChatMessage[]
  translationCaches    TranslationCache[]
  translationHistories TranslationHistory[]
  vocabularyItems      VocabularyItem[]

  @@map("profiles")
}

// ============================================
// PASSAGE MODEL
// ============================================
model Passage {
  id                String     @id @default(cuid())
  userId            String
  title             String
  content           String
  simplifiedContent String?
  originalLevel     CEFRLevel?
  simplifiedLevel   CEFRLevel?
  wordCount         Int
  sourceType        SourceType
  fileUrl           String?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  chatMessages StudyChatMessage[]
  translationCaches TranslationCache[]
  translationHistories TranslationHistory[]
  vocabularyItems VocabularyItem[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deletedAt])
  @@map("passages")
}

model StudyChatMessage {
  id        String   @id @default(cuid())
  userId    String
  passageId String
  role      String
  content   String
  createdAt DateTime @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId, createdAt])
  @@map("study_chat_messages")
}

model DictionaryEntry {
  id              String   @id @default(cuid())
  normalizedKey   String   @unique
  normalizedTerm  String
  sourceLanguage  String
  targetLanguage  String
  translation     String
  type            String?
  pronunciation   String?
  meanings        Json?
  examples        Json?
  relatedWords    Json?
  source          String   @default("local")
  confidence      Float    @default(0.8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceLanguage, targetLanguage, normalizedTerm])
  @@map("dictionary_entries")
}

model TranslationCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  userId          String
  sourceId        String
  selectedText    String
  contextSentence String
  sourceLanguage  String
  targetLanguage  String
  mode            String
  provider        String
  response        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, targetLanguage])
  @@index([userId, createdAt])
  @@map("translation_caches")
}

model TranslationHistory {
  id              String   @id @default(cuid())
  userId          String
  sourceId        String
  selectedText    String
  contextSentence String
  sourceLanguage  String
  targetLanguage  String
  mode            String
  provider        String
  translation     String
  response        Json
  createdAt       DateTime @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, createdAt])
  @@map("translation_histories")
}

model VocabularyItem {
  id              String   @id @default(cuid())
  normalizedKey   String   @unique
  userId          String
  sourceId        String
  selectedText    String
  translation     String
  contextSentence String
  sourceLanguage  String
  targetLanguage  String
  type            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, sourceId, createdAt])
  @@map("vocabulary_items")
}

// ============================================
// QUESTION MODEL (Flashcards)
// ============================================
model Question {
  id            String       @id @default(cuid())
  passageId     String
  questionText  String
  options       Json
  correctOption String
  sourceText    String
  sourceLine    Int
  explanation   String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  difficulty    Int          @default(3)
  createdAt     DateTime     @default(now())

  passage Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  reviews CardReview[]

  @@index([passageId])
  @@map("questions")
}

// ============================================
// CARD REVIEW MODEL (SM-2 Tracking)
// ============================================
model CardReview {
  id         String @id @default(cuid())
  questionId String
  userId     String

  qualityRating Int
  easeFactor    Float @default(2.5)
  intervalDays  Int   @default(1)
  repetitions   Int   @default(0)

  nextReviewDate DateTime @default(now())
  reviewedAt     DateTime @default(now())

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId, nextReviewDate])
  @@map("card_reviews")
}

// ============================================
// STUDY SESSION MODEL
// ============================================
model StudySession {
  id        String  @id @default(cuid())
  userId    String
  passageId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  cardsReviewed  Int    @default(0)
  newCards       Int    @default(0)
  correctCount   Int    @default(0)
  incorrectCount Int    @default(0)
  accuracyRate   Float?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ============================================
// ENUMS
// ============================================
enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SourceType {
  TEXT
  PDF
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Tier {
  FREE
  PRO
}
