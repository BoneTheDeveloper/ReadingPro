generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model file_upload_intents {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  pathname  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  profiles  profiles @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model passages {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String
  title                 String
  content               String
  cefrLevel             CEFRLevel?
  wordCount             Int
  sourceType            SourceType
  filePath              String?                 @unique
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  youtubeUrl            String?
  profiles              profiles                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions             questions[]
  studio_artifacts      studio_artifacts[]
  study_chat_messages   study_chat_messages[]

  @@index([createdAt])
  @@index([userId, deletedAt])
  @@index([userId])
}

model profiles {
  id                    String                  @id
  bio                   String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  file_upload_intents   file_upload_intents[]
  passages              passages[]
  user                  user                    @relation(fields: [id], references: [id], onDelete: Cascade)
  studio_artifacts      studio_artifacts[]
  study_chat_messages   study_chat_messages[]
  upload_jobs           upload_jobs[]
  vocabulary_items      vocabulary_items[]
  vocabulary_sets       vocabulary_sets[]
}

model questions {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passageId        String           @db.Uuid
  artifactId       String           @db.Uuid
  questionText     String
  options          Json
  correctOption    String
  sourceText       String
  sourceLine       Int
  explanation      String
  questionType     QuestionType     @default(MULTIPLE_CHOICE)
  difficulty       Int              @default(3)
  createdAt        DateTime         @default(now())
  studio_artifacts studio_artifacts @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  passages         passages         @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([passageId])
}

model question_results {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId       String           @unique @db.Uuid
  completedAt      DateTime         @default(now())
  correctCount     Int
  totalQuestions   Int
  accuracyRate     Float
  studio_artifacts studio_artifacts @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model studio_artifacts {
  id           String        @id @db.Uuid
  passageId    String        @db.Uuid
  userId       String
  type         String
  title        String
  status       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  questions    questions[]
  question_results question_results?
  passages     passages      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  profiles     profiles      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([passageId, createdAt(sort: Desc)])
  @@index([userId])
}

model study_chat_messages {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  passageId String   @db.Uuid
  role      String
  content   String
  createdAt DateTime @default(now())
  passages  passages @relation(fields: [passageId], references: [id], onDelete: Cascade)
  profiles  profiles @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, passageId, createdAt])
}

model upload_jobs {
  id         String       @id
  userId     String
  status     UploadStatus @default(PENDING)
  sourceType String
  blobPath   String?
  passageId  String?
  error      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  profiles   profiles     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, status])
}

model user {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  tier             String?   @default("FREE")
  stripeCustomerId String?
  account          account[]
  profiles         profiles?
  session          session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

model vocabulary_items {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String
  translation            String
  sourceLanguage         String
  targetLanguage         String
  type                   String                   @default("WORD")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  normalizedText         String                   @default("")
  displayText            String                   @default("")
  normalizedTranslation  String                   @default("")
  savedCount             Int                      @default(1)
  nextReviewAt           DateTime?
  lastReviewedAt         DateTime?
  dictionaryEntryId      String?                  @db.Uuid
  dictionarySenseId      String?                  @db.Uuid
  status                 VocabularyStatus         @default(NEW)
  source                 VocabularySourceType     @default(TRANSLATE)
  profiles               profiles                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary_occurrences vocabulary_occurrences[]
  vocabulary_set_items   vocabulary_set_items[]

  @@unique([userId, normalizedText, targetLanguage, normalizedTranslation])
  @@index([userId, nextReviewAt])
  @@index([userId, status])
}

model vocabulary_occurrences {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vocabularyItemId String           @db.Uuid
  sourceId         String?          @db.Uuid
  selectedText     String
  contextSentence  String?
  createdAt        DateTime         @default(now())
  vocabulary_items vocabulary_items @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([vocabularyItemId, sourceId, contextSentence])
  @@index([sourceId])
}

model vocabulary_set_items {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vocabularySetId  String           @db.Uuid
  vocabularyItemId String           @db.Uuid
  addedAt          DateTime         @default(now())
  vocabulary_items vocabulary_items @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  vocabulary_sets  vocabulary_sets  @relation(fields: [vocabularySetId], references: [id], onDelete: Cascade)

  @@unique([vocabularySetId, vocabularyItemId])
}

model vocabulary_sets {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String
  name                 String
  type                 VocabularySetType
  periodStart          DateTime?
  periodEnd            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  vocabulary_set_items vocabulary_set_items[]
  profiles             profiles               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart, periodEnd])
  @@index([userId, type])
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum SourceType {
  TEXT
  PDF
  YOUTUBE
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum VocabularySetType {
  MANUAL
  DAILY
  WEEKLY
}

enum VocabularySourceType {
  TRANSLATE
  DICTIONARY
}

enum VocabularyStatus {
  NEW
  LEARNING
  MASTERED
}
