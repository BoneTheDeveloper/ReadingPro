// [Upload] Short-lived records that authorize private file (PDF) uploads.

/// A pending upload authorization: grants temporary, expiring access to a private
/// Blob pathname before the file becomes a Passage. Server-only; consumed/expired
/// after the upload completes. Client: backs the upload flow's signed access.
model FileUploadIntent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  /// Reserved Blob pathname for the upload; unique. Server-only.
  pathname  String   @unique
  /// Deadline after which the intent (and its access) is no longer valid.
  expiresAt DateTime
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("file_upload_intents")
}

// [Study · Sources] Reading material the learner studies, plus the chat thread
// attached to a passage. A passage is the root entity the study workspace loads;
// studio artifacts, translations, and chat all hang off it.

/// A reading passage: the source text a learner studies, created by paste (TEXT)
/// or PDF extraction. Client: rows in the study sources panel; opening one loads
/// the study workspace (content + studio).
model Passage {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  title             String
  /// Extracted text used for quiz generation.
  content           String
  /// CEFR level of `content`; set at upload via AI or heuristic.
  cefrLevel         CEFRLevel?
  wordCount         Int
  sourceType        SourceType
  /// Blob pathname of the source (PDF in blob, YouTube as embed URL).
  /// Used for Source view rendering. Null for TEXT sources.
  filePath          String?    @unique
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user                 UserProfile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions            Question[]
  chatMessages         StudyChatMessage[]
  translationCaches    TranslationCache[]
  translationHistories TranslationHistory[]
  studioArtifacts      StudioArtifact[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deletedAt])
  @@map("passages")
}

/// One message in the per-passage AI chat thread. Client: studio chat panel.
model StudyChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  passageId String   @db.Uuid
  role      String
  content   String
  createdAt DateTime @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([userId, passageId, createdAt])
  @@map("study_chat_messages")
}
