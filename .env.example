# OpenAI API Key (required for AI features)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# App URL used for auth redirects and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Neon PostgreSQL
# DATABASE_URL is the pooled runtime connection. DIRECT_URL is direct and is
# allowed only in local/trusted migration jobs, never application runtime.
DATABASE_URL="postgresql://app_owner:password@ep-example-pooler.region.aws.neon.tech/app?sslmode=require&channel_binding=require&uselibpqcompat=true"
DIRECT_URL="postgresql://app_owner:password@ep-example.region.aws.neon.tech/app?sslmode=require&channel_binding=require&uselibpqcompat=true"


# Dev inngest mode
INNGEST_DEV=1

# Vercel Blob Storage
# Local dev uses filesystem (.local-blob-storage/) — no token needed.
# In Vercel, create two Blob stores (preview + production) and assign the
# matching token to each environment in Project Settings > Environment Variables:
#   Preview  → BLOB_READ_WRITE_TOKEN=vercel_blob_rw_preview_xxx
#   Production → BLOB_READ_WRITE_TOKEN=vercel_blob_rw_prod_xxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
#pnpm start in local treat to use local blob
# Values: local | blob (default: blob)
STORAGE_PROVIDER=local

# Protects scheduled expired-upload cleanup.
CRON_SECRET=replace_with_a_long_random_secret

# GitHub Actions only; never inject into app runtime:
# NEON_API_KEY
# NEON_PROJECT_ID
# NEON_PRODUCTION_BRANCH_ID
# VERCEL_TOKEN
# VERCEL_ORG_ID
# VERCEL_PROJECT_ID

# Sentry Error Monitoring (leave DSN empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source maps upload (CI only - keep AUTH_TOKEN secret!)
# Set these as CI secrets/environment variables:
#   SENTRY_AUTH_TOKEN  - Generate at: https://sentry.io/settings/account/api/auth-tokens/
#   SENTRY_ORG         - Your Sentry organization slug
#   SENTRY_PROJECT      - Your Sentry project slug
#   CI=true             - Enables upload (silent mode off)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Translation: Quick sentence/paragraph translation uses a non-AI machine
# translation provider (Google Translate-compatible endpoint). No API key
# required for the default provider. Provider failure returns a standard
# 500 error without falling back to AI.
