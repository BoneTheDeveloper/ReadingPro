# Vercel AI Gateway key
AI_GATEWAY_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=your_32_char_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
OAUTH_PROXY_SECRET=your_oauth_proxy_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email for sign-up OTP codes. Leave SMTP_HOST empty in development to print
# codes in the API log instead. Gmail: smtp.gmail.com, 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ReadingPro <no-reply@example.com>"

# Local Docker database (docker-compose.yml reads these; pick any values)
POSTGRES_USER=readingpro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=readingpro
POSTGRES_PORT=54329

# The app's database. When set, it wins; when removed, the app builds the local
# Docker URL from the POSTGRES_* values above. Production sets it in Vercel.
DATABASE_URL=postgres://readingpro:change-me@localhost:54329/readingpro

# SePay (VietQR bank transfer). The bank account SePay watches, and the API key
# set on the SePay webhook (Authorization: Apikey <key>) pointing at
# https://<your-domain>/api/webhooks/sepay. BANK_CODE is a VietQR bank code, e.g. MB or VCB.
# In SePay, set the payment code prefix to RPRO so it detects order codes.
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
