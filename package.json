{
  "name": "english-reading-training-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --generator client && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "deadcode": "knip",
    "postinstall": "prisma generate --generator client",
    "db:generate": "prisma generate --generator client",
    "db:seed:dictionary": "tsx prisma/seed.ts",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/react": "^4.0.17",
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.53.0",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.178",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "inngest": "^4.11.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^15.0.0",
    "react-resizable-panels": "^4.11.1",
    "server-only": "^0.0.1",
