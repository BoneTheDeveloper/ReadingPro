{
  "name": "english-reading-training-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "nitro dev",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "react-router build",
    "build:api": "nitro build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --only-shell chromium",
    "db:up": "docker compose up -d --wait postgres && pnpm db:migrate",
    "db:down": "docker compose down",
    "db:migrate": "docker compose run --rm --build flyway migrate",
    "db:info": "docker compose run --rm --build flyway info",
    "db:import-dictionary": "node --env-file-if-exists=.env scripts/import-dictionary.ts",
    "db:dictionary-coverage": "node --env-file-if-exists=.env scripts/dictionary-coverage.ts",
    "db:seed-test-accounts": "node --env-file-if-exists=.env scripts/seed-test-accounts.ts",
    "sepay:mock-webhook": "node --env-file-if-exists=.env scripts/sepay-mock-webhook.ts",
    "workflow:inspect": "npx workflow inspect runs --web"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.37",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "4.13.9",
    "isbot": "^5",
    "lucide-react": "^1.27.0",
    "nitro": "3.0.260903-beta",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "^15.0.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "wink-lemmatizer": "3.0.4",
    "workflow": "^4.8.3",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "knip": "^6.29.0",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.1.1"
  }
}
