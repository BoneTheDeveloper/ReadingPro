{
  "name": "english-reading-training-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:performance": "NEXT_DIST_DIR=.next-performance PRISMA_QUERY_METRICS=1 TRANSLATE_PERFORMANCE_FIXTURES=1 DICTIONARY_PERFORMANCE_FIXTURES=1 next dev --turbopack",
    "dev:e2e": "next dev --turbopack -H 0.0.0.0",
    "build": "prisma generate --generator client && next build",
    "build:performance": "NEXT_DIST_DIR=.next-performance-production pnpm build",
    "start": "next start",
    "start:performance": "NEXT_DIST_DIR=.next-performance-production PRISMA_QUERY_METRICS=1 TRANSLATE_PERFORMANCE_FIXTURES=1 DICTIONARY_PERFORMANCE_FIXTURES=1 next start",
    "test": "vitest --config tests/vitest/vitest.config.ts run",
    "test:watch": "vitest --config tests/vitest/vitest.config.ts",
    "test:coverage": "vitest --config tests/vitest/vitest.config.ts run --coverage",
    "e2e": "playwright test --config=playwright/playwright.config.ts",
    "e2e:ui": "playwright test --config=playwright/playwright.config.ts --ui",
    "e2e:debug": "playwright test --config=playwright/playwright.config.ts --debug",
    "e2e:docker": "make e2e-docker",
    "e2e:screenshot": "playwright test --config=playwright/playwright.screenshot.config.ts",
    "test:performance": "tsx tests/performance/run-benchmarks.ts",
    "test:performance:report": "tsx tests/performance/render-benchmark-report.ts",
    "test:e2e": "playwright test --config=playwright/playwright.config.ts",
    "test:e2e:docker": "make e2e-docker",
    "e2e:create-user": "tsx playwright/helpers/create-test-user.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "postinstall": "prisma generate --generator client",
    "db:generate": "prisma generate --generator client",
    "db:generate:all": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:replay:empty": "tsx scripts/database/assert-reset-confirmed.ts && prisma migrate reset --force --skip-seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:dictionary": "tsx prisma/seed.ts",
    "db:seed:dictionary:bulk:dev": "DICTIONARY_SEED_BULK=1 DICTIONARY_SEED_BULK_TARGET=development tsx prisma/seed.ts",
    "db:validate:dictionary": "tsx scripts/dictionary/validate-dictionary.ts",
    "db:check:dictionary-seed": "tsx scripts/dictionary/check-seed-status.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.72",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/react": "^3.0.184",
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.4.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.53.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.178",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^4.11.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "get-port": "^7.2.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
