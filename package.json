{
  "name": "english-reading-training-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"nitro dev --port 3001\" \"react-router dev --port 3000 --strictPort\"",
    "build": "prisma generate --generator client && react-router build && nitro build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint",
    "postinstall": "prisma generate --generator client",
    "db:generate": "prisma generate --generator client",
    "workflow:inspect": "npx workflow inspect runs --web"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.37",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "4.13.9",
    "isbot": "^5",
    "lucide-react": "^1.27.0",
    "nitro": "3.0.260903-beta",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "^15.0.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "workflow": "^4.8.3",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "knip": "^6.29.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
