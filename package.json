    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-boundaries": "^7.0.2",
    "knip": "^6.26.0",
    "pino-pretty": "^13.1.3",
